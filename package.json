{
  "name": "onechat-dev-login-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/run.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "lint": "prettier --check src scripts tests public package.json tsconfig.json",
    "format": "prettier --write src scripts tests public package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "papaparse": "5.7.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
